{
  "name": "nellys-garden",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.19.4"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@template/web",
    "dev:desktop": "npm run dev --workspace=@template/desktop",
    "dev:mobile": "npm run start --workspace=@template/mobile",
    "start": "pm2 startOrRestart ecosystem.config.cjs --update-env",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=@template/web",
    "lint": "oxlint . --deny-warnings --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix --deny-warnings --no-error-on-unmatched-pattern",
    "typecheck": "npm run typecheck --workspaces",
    "db:generate": "npm run db:generate --workspace=@template/web",
    "db:migrate": "npm run db:migrate --workspace=@template/web",
    "db:push": "npm run db:push --workspace=@template/web",
    "db:studio": "npm run db:studio --workspace=@template/web",
    "kill:port": "node tools/kill-port.cjs"
  },
  "devDependencies": {
    "@tursodatabase/api": "^1.9.2",
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0",
    "turbo": "2.9.18",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1023.0",
    "@libsql/client": "^0.17.2",
    "cloudflare": "^5.2.0",
    "pm2": "^7.0.1"
  }
}
